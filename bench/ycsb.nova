import datetime;
import math;
import string;
import list;
import env;
import data.btree.client;

pub struct Rand {
    pub state: i64,

    init(seed: i64) {
        let s = seed % 2147483647;
        if (s <= 0) { s = s + 2147483646; }
        self.state = s;
    }

    pub fn next(self: Rand): i64 {
        self.state = (self.state * 48271) % 2147483647;
        return self.state;
    }

    pub fn nextInt(self: Rand, n: i32): i32 {
        if (n <= 0) { return 0; }
        return (self.next() % (n as i64)) as i32;
    }

    pub fn nextDouble(self: Rand): f64 {
        return (self.next() as f64) / 2147483647.0;
    }
}

pub struct Zipf {
    pub items: i32,
    pub theta: f64,
    pub zetan: f64,
    pub alpha: f64,
    pub eta: f64,
    pub half_pow_theta: f64,

    init(items: i32, theta: f64) {
        self.items = items;
        self.theta = theta;
        self.zetan = zeta(items, theta);
        let zeta2 = zeta(2, theta);
        self.alpha = 1.0 / (1.0 - theta);
        let n_f = items as f64;
        self.eta = (1.0 - math.fpowf(2.0 / n_f, 1.0 - theta)) / (1.0 - (zeta2 / self.zetan));
        self.half_pow_theta = math.fpowf(0.5, theta);
    }

    pub fn next(self: Zipf, r: Rand): i32 {
        let u = r.nextDouble();
        let uz = u * self.zetan;
        if (uz < 1.0) { return 0; }
        if (uz < 1.0 + self.half_pow_theta) { return 1; }
        let v = math.fpowf((self.eta * u) - self.eta + 1.0, self.alpha);
        let idx = ((self.items as f64) * v) as i32;
        if (idx < 0) { idx = 0; }
        if (idx >= self.items) { idx = self.items - 1; }
        return idx;
    }
}

fn zeta(n: i32, theta: f64): f64 {
    let sum = 0.0;
    let i = 1;
    while (i <= n) {
        sum = sum + (1.0 / math.fpowf(i as f64, theta));
        i = i + 1;
    }
    return sum;
}

fn histMax(): i32 { return 20000; }

pub struct Stats {
    pub ops: i32,
    pub errors: i32,
    pub hist: list.List<i32>,

    init() {
        self.ops = 0;
        self.errors = 0;
        self.hist = list.List<i32>();
        let i = 0;
        while (i <= histMax()) { self.hist.push(0); i = i + 1; }
    }

    pub fn record(self: Stats, us: i32): void {
        self.ops = self.ops + 1;
        let b = us;
        if (b < 0) { b = 0; }
        if (b > histMax()) { b = histMax(); }
        self.hist.set(b, self.hist.get(b) + 1);
    }
}

fn percentile(hist: list.List<i32>, total: i32, p: i32): i32 {
    if (total <= 0) { return 0; }
    let target = (total * p) / 100;
    let seen = 0;
    let i = 0;
    while (i <= histMax()) {
        seen = seen + hist.get(i);
        if (seen >= target) { return i; }
        i = i + 1;
    }
    return histMax();
}

fn keyOf(i: i32): string {
    return "user" + __i32_to_string(i);
}

fn payload(n: i32): string {
    let s = "";
    let i = 0;
    while (i < n) {
        s = s + "x";
        i = i + 1;
    }
    return s;
}

fn insertSql(key: string, val: string, fields: i32): string {
    let cols = "ykey";
    let vals = "'" + key + "'";
    let f = 0;
    while (f < fields) {
        cols = cols + ",field" + __i32_to_string(f);
        vals = vals + ",'" + val + "'";
        f = f + 1;
    }
    return "INSERT INTO usertable (" + cols + ") VALUES (" + vals + ")";
}

fn readSql(key: string): string {
    return "SELECT * FROM usertable WHERE ykey='" + key + "'";
}

fn updateSql(key: string, val: string, field: i32): string {
    return "UPDATE usertable SET field" + __i32_to_string(field) + "='" + val + "' WHERE ykey='" + key + "'";
}

fn scanSql(key: string, count: i32): string {
    return "SELECT * FROM usertable WHERE ykey>='" + key + "' LIMIT " + __i32_to_string(count);
}

pub struct Mix {
    pub read: i32,
    pub update: i32,
    pub insert: i32,
    pub scan: i32,
    pub rmw: i32,

    init(read: i32, update: i32, insert: i32, scan: i32, rmw: i32) {
        self.read = read;
        self.update = update;
        self.insert = insert;
        self.scan = scan;
        self.rmw = rmw;
    }
}

fn mixFor(w: string): Mix {
    if (string.eql(w, "a")) { return Mix(50, 50, 0, 0, 0); }
    if (string.eql(w, "b")) { return Mix(95, 5, 0, 0, 0); }
    if (string.eql(w, "d")) { return Mix(95, 0, 5, 0, 0); }
    if (string.eql(w, "e")) { return Mix(0, 0, 5, 95, 0); }
    if (string.eql(w, "f")) { return Mix(50, 0, 0, 0, 50); }
    return Mix(100, 0, 0, 0, 0);
}

async fn runWorker(id: i32, ops: i32, records: i32, fields: i32, fieldlen: i32,
                   workload: string, host: string, port: i32, st: Stats): i32 {
    let conn = client.connect(host, port, "admin", "nova");
    let r = Rand((id * 7919) + 12345);
    let zipf = Zipf(records, 0.99);
    let mix = mixFor(workload);
    let val = payload(fieldlen);
    let is_latest = string.eql(workload, "d");

    let i = 0;
    while (i < ops) {
        let k = 0;
        if (is_latest) {
            k = records - 1 - zipf.next(r);
            if (k < 0) { k = 0; }
        } else {
            k = zipf.next(r);
        }
        let key = keyOf(k);

        let choice = r.nextInt(100);
        let t0 = datetime.nowNs();
        let failed = false;

        if (choice < mix.read) {
            let res = client.query(conn, readSql(key));
            if (res.error != "") { failed = true; }
        } else if (choice < mix.read + mix.update) {
            let res = client.query(conn, updateSql(key, val, r.nextInt(fields)));
            if (res.error != "") { failed = true; }
        } else if (choice < mix.read + mix.update + mix.insert) {
            let nk = keyOf(records + (id * ops) + i);
            let res = client.query(conn, insertSql(nk, val, fields));
            if (res.error != "") { failed = true; }
        } else if (choice < mix.read + mix.update + mix.insert + mix.scan) {
            let res = client.query(conn, scanSql(key, 1 + r.nextInt(100)));
            if (res.error != "") { failed = true; }
        } else {
            let res = client.query(conn, readSql(key));
            if (res.error != "") { failed = true; }
            let res2 = client.query(conn, updateSql(key, val, r.nextInt(fields)));
            if (res2.error != "") { failed = true; }
        }

        let t1 = datetime.nowNs();
        st.record(((t1 - t0) / 1000) as i32);
        if (failed) { st.errors = st.errors + 1; }
        i = i + 1;
    }
    client.close(conn);
    return st.ops;
}

async fn loadWorker(id: i32, lo: i32, hi: i32, fields: i32, fieldlen: i32,
                    host: string, port: i32, st: Stats): i32 {
    let conn = client.connect(host, port, "admin", "nova");
    let val = payload(fieldlen);
    let i = lo;
    while (i < hi) {
        let t0 = datetime.nowNs();
        let res = client.query(conn, insertSql(keyOf(i), val, fields));
        let t1 = datetime.nowNs();
        st.record(((t1 - t0) / 1000) as i32);
        if (res.error != "") { st.errors = st.errors + 1; }
        i = i + 1;
    }
    client.close(conn);
    return st.ops;
}

async fn runLoad(threads: i32, records: i32, fields: i32, fieldlen: i32,
                 host: string, port: i32, stats: list.List<Stats>): i32 {
    let hs = list.List<i64>();
    let per = (records + threads - 1) / threads;
    let t = 0;
    while (t < threads) {
        let lo = t * per;
        let hi = lo + per;
        if (hi > records) { hi = records; }
        if (lo < hi) {
            hs.push(go loadWorker(t, lo, hi, fields, fieldlen, host, port, stats.get(t)));
        }
        t = t + 1;
    }
    let total = 0;
    let j = 0;
    while (j < hs.size()) {
        total = total + await hs.get(j);
        j = j + 1;
    }
    return total;
}

async fn runPhase(threads: i32, ops: i32, records: i32, fields: i32, fieldlen: i32,
                  workload: string, host: string, port: i32, stats: list.List<Stats>): i32 {
    let hs = list.List<i64>();
    let per = (ops + threads - 1) / threads;
    let t = 0;
    while (t < threads) {
        hs.push(go runWorker(t, per, records, fields, fieldlen, workload, host, port, stats.get(t)));
        t = t + 1;
    }
    let total = 0;
    let j = 0;
    while (j < hs.size()) {
        total = total + await hs.get(j);
        j = j + 1;
    }
    return total;
}

fn report(label: string, stats: list.List<Stats>, threads: i32, ms: i32): void {
    let merged = list.List<i32>();
    let i = 0;
    while (i <= histMax()) { merged.push(0); i = i + 1; }

    let total = 0;
    let errors = 0;
    let t = 0;
    while (t < threads) {
        let s = stats.get(t);
        total = total + s.ops;
        errors = errors + s.errors;
        let b = 0;
        while (b <= histMax()) {
            merged.set(b, merged.get(b) + s.hist.get(b));
            b = b + 1;
        }
        t = t + 1;
    }

    console.log("");
    console.log("=== " + label + " ===");
    console.log("  ops         : " + __i32_to_string(total));
    console.log("  errors      : " + __i32_to_string(errors));
    console.log("  elapsed_ms  : " + __i32_to_string(ms));
    if (ms > 0) {
        console.log("  throughput  : " + __i32_to_string((total * 1000) / ms) + " ops/sec");
    }
    console.log("  latency us  : p50=" + __i32_to_string(percentile(merged, total, 50)) +
                "  p95=" + __i32_to_string(percentile(merged, total, 95)) +
                "  p99=" + __i32_to_string(percentile(merged, total, 99)) +
                "  p999=" + __i32_to_string(percentile(merged, total, 999 / 10)));
}

fn atoi(s: string): i32 {
    let n = 0;
    let i = 0;
    while (i < s.length) {
        let c = s[i];
        if (c < 48 || c > 57) { return 0 - 1; }
        n = (n * 10) + (c - 48);
        i = i + 1;
    }
    if (i == 0) { return 0 - 1; }
    return n;
}

fn envInt(name: string, dflt: i32): i32 {
    let v = env.get(name);
    if (string.eql(v, "")) { return dflt; }
    let n = atoi(v);
    if (n <= 0) { return dflt; }
    return n;
}

fn envStr(name: string, dflt: string): string {
    let v = env.get(name);
    if (string.eql(v, "")) { return dflt; }
    return v;
}

fn schemaSql(fields: i32): string {
    let s = "CREATE TABLE usertable (ykey TEXT PRIMARY KEY";
    let f = 0;
    while (f < fields) {
        s = s + ", field" + __i32_to_string(f) + " TEXT";
        f = f + 1;
    }
    return s + ")";
}

fn main(): void {
    let workload = envStr("YCSB_WORKLOAD", "c");
    let records = envInt("YCSB_RECORDS", 10000);
    let ops = envInt("YCSB_OPS", 50000);
    let threads = envInt("YCSB_THREADS", 8);
    let fields = envInt("YCSB_FIELDS", 10);
    let fieldlen = envInt("YCSB_FIELDLEN", 100);
    let host = envStr("YCSB_HOST", "127.0.0.1");
    let port = envInt("YCSB_PORT", 3009);
    let phase = envStr("YCSB_LOAD", "both");

    console.log("YCSB (Nova) -> NovaDB " + host + ":" + __i32_to_string(port));
    console.log("  workload=" + workload + " records=" + __i32_to_string(records) +
                " ops=" + __i32_to_string(ops) + " threads=" + __i32_to_string(threads) +
                " fields=" + __i32_to_string(fields) + "x" + __i32_to_string(fieldlen) + "B");

    let do_load = !string.eql(phase, "0");
    let do_run = !string.eql(phase, "1");

    if (do_load) {
        let setup = client.connect(host, port, "admin", "nova");
        client.query(setup, "DROP TABLE usertable");
        let cr = client.query(setup, schemaSql(fields));
        if (cr.error != "") { console.log("  schema error: " + cr.error); }
        client.close(setup);

        let lstats = list.List<Stats>();
        let i = 0;
        while (i < threads) { lstats.push(Stats()); i = i + 1; }

        let t0 = datetime.nowNs();
        let n = runLoad(threads, records, fields, fieldlen, host, port, lstats);
        let t1 = datetime.nowNs();
        report("LOAD", lstats, threads, ((t1 - t0) / 1000000) as i32);
    }

    if (do_run) {
        let rstats = list.List<Stats>();
        let j = 0;
        while (j < threads) { rstats.push(Stats()); j = j + 1; }

        let t2 = datetime.nowNs();
        let m = runPhase(threads, ops, records, fields, fieldlen, workload, host, port, rstats);
        let t3 = datetime.nowNs();
        report("RUN workload=" + workload, rstats, threads, ((t3 - t2) / 1000000) as i32);
    }
}
